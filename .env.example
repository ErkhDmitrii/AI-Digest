# === Telegram Bot ===
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=-1
TARGET_CHANNEL_ID=-1

# === Telethon (Userbot для чтения каналов) ===
TELETHON_API_ID=123456
TELETHON_API_HASH=abcdef1234567890abcdef1234567890
TELETHON_SESSION=ai_digest_session

# === LLM API (OpenAI-совместимый) ===
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# === Расписание ===
TIMEZONE=Asia/Tbilisi
COLLECT_INTERVAL_HOURS=2
DIGEST_HOUR=8

# === База данных ===
DB_PATH=ai_digest.db
